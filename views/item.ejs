<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Who Pays Artists?</title>
    <meta name="description" content="An anonymous report about how an artist was paid for their work.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css?family=Oswald|Open+Sans+Condensed:300,300italic" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="/javascript/printReport.js" defer></script>
<% if(!err) { %>
    <script id="report-data" type="application/json"><%- reportJson %></script>
    <script src="/javascript/item.js" defer></script>
<% } %>
  </head>
  <body>
    <div class="wrapper">

      <div id="header" class="section">
        <a href="/"><h1>Who Pays<img src="/images/header.png" alt="">Artists<span class="q">?</span></h1></a>
      </div>

      <img src="/images/top-background.png" class="split" alt="">

      <div id="intro" class="section">
        <% if(err) { %><h2>Sorry, that item doesn't exist.</h2><% } %>
      </div>

    </div>

      <div id="footer">
        <p>Access all of the data in a single <a href="/data.json">JSON</a> or <a href="/data.csv">CSV</a> file.</p>
        <p><a href="mailto:info@whopaysartists.com" target="_blank">Contact us</a> or contribute on <a href="https://github.com/kylemcdonald/whopaysartists/" target="_blank">GitHub</a></p>
      </div>
  </body>
</html>
